# Copy to .env for `docker compose up`. Never commit .env.
# --- accounts (seed) ---
ADMIN_EMAIL=you@yourcompany.com
ADMIN_PASSWORD=change-me-now
# Optional: creates the demo users (editor@bots.demo, viewer@bots.demo, ...) with this password.
DEMO_USERS_PASSWORD=
# Allows POST /api/admin/seed on this instance (demo data reset). Leave empty on a client instance.
ALLOW_DEMO_RESEED=true
# Optional: protects the reminder cron webhook.
WEBHOOK_CRON_SECRET=

# --- API ---
# Signs login tokens. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:3000
DB_NAME=bots

# --- AI provider (fake = deterministic stand-in, no key needed; anthropic = the owner's key) ---
BOTS_LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
BOTS_LLM_MODEL=claude-opus-5-5
BOTS_LLM_CONCURRENCY=3

# --- Attachments storage: local = files under BOTS_STORAGE_DIR (docker compose mounts the "attachments"
#     volume there); s3 = a bucket; emergent = the hosted object store. Default: emergent when
#     EMERGENT_LLM_KEY is set, else local.
BOTS_STORAGE_PROVIDER=local
BOTS_STORAGE_DIR=
# s3: bucket name plus the standard AWS variables. BOTS_S3_ENDPOINT_URL only for S3-compatible stores.
BOTS_S3_BUCKET=
BOTS_S3_ENDPOINT_URL=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Transactional email (checkpoint nudges): smtp | emergent | none.
#     Default: emergent when EMERGENT_EMAIL_KEY is set, else none (nudges are logged, not sent).
BOTS_EMAIL_PROVIDER=none
BOTS_SMTP_HOST=
BOTS_SMTP_PORT=587
BOTS_SMTP_USER=
BOTS_SMTP_PASSWORD=
BOTS_SMTP_FROM=no-reply@yourcompany.com
# false only for a local relay without TLS (port 465 uses implicit TLS and ignores this).
BOTS_SMTP_STARTTLS=true
EMAIL_FROM_NAME=BOTS
EMAIL_REPLY_TO=
